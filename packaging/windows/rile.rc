// Embedded into rile.exe by crates/rile-app/build.rs. gpui embeds the
// application manifest (DPI awareness, common controls) itself.
#include <winver.h>

1 ICON RILE_ICON

VS_VERSION_INFO VERSIONINFO
FILEVERSION RILE_VERSION_COMMA
PRODUCTVERSION RILE_VERSION_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rile"
            VALUE "FileDescription", "Rile"
            VALUE "FileVersion", RILE_VERSION_STR
            VALUE "InternalName", "rile"
            VALUE "OriginalFilename", "rile.exe"
            VALUE "ProductName", "Rile"
            VALUE "ProductVersion", RILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
